extends RefCounted
const ART := preload("res://scripts/data/character_sheet.gd")

func run(tree: SceneTree) -> void:
	_test_white_matte()
	var save: Node = tree.root.get_node("SaveManager")
	var previous: Dictionary = save.data.duplicate(true)
	save.data = save.DEFAULT_SAVE.duplicate(true)
	save._initialize_progression(false)
	save.data.gold = 100000
	assert(save.unlock_class("assassin") and save.unlock_class("druid"))
	assert(ART.SHEETS.size() == 5 and not ART.has_class("paladin"))
	for owner in ART.SHEETS:
		var texture: Texture2D = ART.texture_for(owner)
		var image := texture.get_image()
		if owner == "druid": assert(image.get_pixel(147, 144).a > 0.9, "The pale beard must survive removal of enclosed checkerboard")
		assert(image.detect_alpha() != Image.ALPHA_NONE)
		for action in ART.POSES[owner]:
			for index in ART.POSES[owner][action].size():
				var atlas := ART.atlas(owner, action, index)
				assert(Rect2(Vector2.ZERO, texture.get_size()).encloses(atlas.region))
				var frame := image.get_region(Rect2i(atlas.region))
				var used := frame.get_used_rect()
				assert(used.size.y >= 20 and used.size.x >= 20, "%s %s %d must contain a real pose" % [owner, action, index])
				if owner in ["ranger", "assassin", "druid"]:
					assert(frame.get_pixel(0, 0).a == 0.0, "%s %s %d background must be transparent" % [owner, action, index])
				assert(ART.atlas(owner, action, index) == atlas, "Atlas resources must be cached")
		var idle := ART.sample(owner, {"time": 0.0})
		var walk := ART.sample(owner, {"time": 0.2, "moving": 1.0})
		var run := ART.sample(owner, {"time": 0.2, "moving": 1.0, "running": true})
		var attack := ART.sample(owner, {"attacking": true, "attack_progress": 0.5})
		var special := ART.sample(owner, {"attacking": true, "attack_progress": 0.5, "special": true})
		var hurt := ART.sample(owner, {"hurt": 0.15})
		var dead := ART.sample(owner, {"dead": true, "death_elapsed": 3.0})
		assert(idle.action == "idle" and walk.action == "walk" and run.action == "run")
		assert(attack.action == "attack" and special.action == "special" and attack.texture != special.texture)
		assert(hurt.action == "hurt" and dead.action == "death" and dead.index == ART.POSES[owner].death.size() - 1)
		var player := SurvivorPlayer.new()
		player.configure(owner, {})
		player.use_local_input = false
		tree.root.add_child(player)
		player.set_physics_process(false)
		var baseline := Vector3(player.damage, player.max_health, player.move_speed)
		var sprite: Sprite2D = player.get_node("CharacterSprite")
		player.play_attack(Vector2.LEFT)
		sprite.pose(owner, player.animation_state(), Color.WHITE)
		assert(sprite.flip_h and sprite.get_meta("animation") == "attack")
		assert(sprite.texture_filter == CanvasItem.TEXTURE_FILTER_NEAREST and is_equal_approx(sprite.scale.x, 45.0 / float(ART.HEIGHTS[owner])))
		player.play_attack(Vector2.RIGHT, false, &"magic", true)
		sprite.pose(owner, player.animation_state(), Color.WHITE)
		assert(not sprite.flip_h and sprite.get_meta("animation") == "special")
		var row := preload("res://scripts/network/world_replica.gd")._row(player, "P", "P1")
		assert(row.v.attack_special and row.v.has("death_elapsed"))
		if owner in ["warrior", "mage"]: assert(sprite.get_node("EquippedModel0").visible)
		if owner == "warrior": assert(sprite.get_node("EquippedModel1").visible)
		player.take_damage(player.max_health * 100)
		assert(player.is_dead and player.death_elapsed == 0)
		player._physics_process(0.7)
		sprite.pose(owner, player.animation_state(), Color.WHITE)
		assert(sprite.get_meta("animation") == "death" and not sprite.get_node("EquippedModel0").visible)
		player.revive()
		assert(not player.is_dead and player.death_elapsed == 0 and Vector3(player.damage, player.max_health, player.move_speed) == baseline)
		var portrait: Control = load("res://scripts/ui/menu_portrait.gd").new()
		portrait.class_id = owner
		portrait.size = Vector2(180, 240)
		tree.root.add_child(portrait)
		assert(portrait.texture_for(owner) == ART.atlas(owner) and portrait.texture_for(owner, true) == ART.atlas(owner, "face"))
		assert(not portrait.is_processing() and ART.atlas(owner).get_height() > ART.atlas(owner, "idle").get_height() * 2.4, "Menus use the larger static portrait, not enlarged animation frames")
		await tree.process_frame
		assert(portrait.animation_time == 0.0)
		player.queue_free()
		portrait.queue_free()
		await tree.process_frame
	var paladin := SurvivorPlayer.new()
	paladin.configure("paladin", {})
	assert(not paladin.has_node("CharacterSprite"), "The sixth class keeps its articulated original model")
	paladin.free()
	var main: Node = load("res://scenes/main.tscn").instantiate()
	tree.root.add_child(main)
	main._build_page("home")
	await tree.process_frame
	var home: Control = main.page_root.find_child("HomeScreen", true, false)
	assert(home.find_child("HomePrepare", true, false) == null)
	var character: Button = home.navigation.get_child(0)
	assert(character.title == "PERSONAGEM" and character.page == "prepare")
	character.pressed.emit()
	await tree.process_frame
	var preparation: Control = main.page_root.find_child("PrepareScreen", true, false)
	assert(main.page_name == "prepare" and preparation.cards.get_child_count() == 6)
	preparation.cards.get_child(0).pressed.emit()
	assert(main.page_name == "characters")
	main._go_back()
	assert(main.page_name == "prepare")
	main._go_back()
	assert(main.page_name == "home")
	main.queue_free()
	await tree.process_frame
	save.data = previous
	save.save_game()
	print("PASS PLAYER SHEETS: five original charts, valid explicit crops, checkerboard removal, cached atlas/face portraits, native Sprite2D, idle/walk/run/basic/special/hurt/death, grounded mirroring, revival, equipment overlays, unchanged stats and paladin fallback")

func _test_white_matte() -> void:
	var image := Image.create(12, 12, false, Image.FORMAT_RGBA8)
	image.fill(Color.TRANSPARENT)
	var ink := Color8(40, 70, 30)
	image.fill_rect(Rect2i(3, 3, 6, 6), ink)
	# A real 50% edge was flattened on white, leaving an opaque pale fringe.
	image.set_pixel(2, 5, Color8(148, 163, 143))
	var pixels := image.get_data()
	preload("res://scripts/data/sheet_background.gd").remove_white_fringe(pixels, pixels.duplicate(), 12, [0, 0, 12, 12])
	var cleaned := Image.create_from_data(12, 12, false, Image.FORMAT_RGBA8, pixels)
	var edge := cleaned.get_pixel(2, 5)
	assert(edge.a > 0.45 and edge.a < 0.55 and absf(edge.r - ink.r) < 0.02 and absf(edge.g - ink.g) < 0.02, "Recover the true alpha and color instead of deleting the outline")
	assert(cleaned.get_pixel(5, 5) == ink, "Solid interior colors must not change")
